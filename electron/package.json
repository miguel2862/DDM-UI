{
  "name": "ddm-ui",
  "version": "3.2.0",
  "description": "DDM-UI — Diffuse Discrepancy Model simulator",
  "author": "Miguel Ángel Aguayo Mendoza",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:frontend": "cd ../frontend && npm run lint && npm run build",
    "test:r": "Rscript ../tests/run_all.R",
    "setup:r": "node scripts/setup-r-portable.js",
    "setup:r:win": "node scripts/setup-r-portable-win.js",
    "preflight:mac": "node scripts/preflight.js mac",
    "preflight:win": "node scripts/preflight.js win",
    "dist:mac": "npm run test:r && npm run build:frontend && npm run setup:r && npm run preflight:mac && electron-builder --mac && node scripts/verify-release.js",
    "dist:win": "npm run build:frontend && npm run preflight:win && electron-builder --win",
    "dist": "npm run dist:mac"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.ddm-ui.app",
    "productName": "DDM-UI",
    "copyright": "Copyright © 2026 Miguel Ángel Aguayo Mendoza - University of Guadalajara",
    "artifactName": "DDM-UI-${version}-${arch}.${ext}",
    "afterPack": "scripts/after-pack.js",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "frontend"
      },
      {
        "from": "../api",
        "to": "api",
        "filter": [
          "plumber.R",
          "simulation.R.dtd-backup",
          "simulation.R",
          "ddm_inspector.R",
          "helpers.R",
          "templates.R",
          "self_tests.R"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.education",
      "icon": "../icon.icns",
      "extraResources": [
        {
          "from": "R-portable",
          "to": "R-portable"
        }
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "identity": null
    },
    "win": {
      "icon": "../icon.ico",
      "extraResources": [
        {
          "from": "R-portable-win",
          "to": "R-portable"
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "../icon.ico",
      "uninstallerIcon": "../icon.ico",
      "installerHeaderIcon": "../icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DDM-UI"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
